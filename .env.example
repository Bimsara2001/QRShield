# Copy to .env only for local process-environment loading. Do not commit .env.
# The backend reads these values from its process environment; it does not load
# dotenv files automatically.
MONGO_URI=mongodb+srv://username:password@host.example/qrshield
VIRUSTOTAL_API_KEY=replace-with-your-virustotal-api-key
QRSHIELD_API_TOKEN=replace-with-a-long-random-application-token
# Removes only unreferenced QRShield UUID screenshots older than this many days.
QRSHIELD_SCREENSHOT_RETENTION_DAYS=30
